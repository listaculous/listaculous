# Public URL where Listaculous is reachable (used in confirm/unsubscribe links). Must be HTTPS in production.
BASE_URL=https://news.example.com
# SQLite (default) or Postgres:
DATABASE_URL=sqlite:///data/listaculous.db?mode=rwc
# DATABASE_URL=postgres://listaculous:secret@db:5432/listaculous
# Set to true when running behind a reverse proxy (Caddy/nginx/Traefik) so client IPs come from X-Forwarded-For.
TRUST_PROXY=true
# Optional default AWS credentials for SES (used when a site leaves its keys blank).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
RUST_LOG=listaculous=info
# Host port used by `make up` / docker compose. Leave unset and `make` picks a random free one.
# PORT=
