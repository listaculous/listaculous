# Public HTTPS URL of this instance (used in confirm/unsubscribe links and for passkeys).
BASE_URL=https://news.example.com
# true when behind a reverse proxy (Caddy/nginx/Traefik) that sets X-Forwarded-For.
# Only enable it if the container is reachable *only* through that proxy.
TRUST_PROXY=true
# Optional: encrypts stored secrets. If unset, a key is generated at /data/secret.key — back it up.
# LISTACULOUS_SECRET_KEY=
RUST_LOG=listaculous=info
